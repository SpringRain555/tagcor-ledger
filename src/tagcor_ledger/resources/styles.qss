QWidget {
    font-family: "Microsoft JhengHei", "Segoe UI", sans-serif;
    font-size: 12pt;
    color: #17202A;
    background-color: #F6F8FA;
}

QMainWindow,
QDialog,
QMessageBox {
    background-color: #F6F8FA;
    color: #17202A;
}

QLabel,
QFormLayout QLabel,
QMessageBox QLabel {
    color: #17202A;
    background-color: transparent;
}

QLineEdit,
QComboBox,
QDateTimeEdit,
QTableWidget,
QTableView,
QListWidget {
    color: #17202A;
    background-color: #FFFFFF;
    border: 1px solid #A9B4C2;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #1F6FEB;
    selection-color: #FFFFFF;
}

QLineEdit {
    min-height: 28px;
    placeholder-text-color: #697586;
}

QLineEdit:focus,
QComboBox:focus,
QDateTimeEdit:focus,
QTableView:focus,
QListWidget:focus {
    color: #17202A;
    background-color: #FFFFFF;
    border: 2px solid #1F6FEB;
}

QLineEdit:disabled,
QComboBox:disabled {
    color: #697586;
    background-color: #EEF2F6;
    border-color: #CDD5DF;
}

QComboBox {
    min-height: 28px;
    padding-right: 26px;
}

QListWidget {
    padding: 8px;
    background-color: #17202A;
    color: #E7ECF2;
    border: 0;
    border-radius: 0;
}

QListWidget::item {
    padding: 10px 12px;
    border-radius: 6px;
}

QListWidget::item:selected {
    color: #FFFFFF;
    background-color: #1F6FEB;
}

QComboBox::drop-down {
    width: 24px;
    border-left: 1px solid #CDD5DF;
    background-color: #EEF2F6;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    color: #17202A;
    background-color: #FFFFFF;
    border: 1px solid #A9B4C2;
    selection-background-color: #1F6FEB;
    selection-color: #FFFFFF;
    outline: 0;
}

QPushButton {
    color: #FFFFFF;
    background-color: #1F6FEB;
    border: 1px solid #1A5FD0;
    border-radius: 6px;
    padding: 7px 14px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #1A5FD0;
}

QPushButton:pressed {
    background-color: #174EA6;
}

QPushButton:focus {
    border: 2px solid #0F3D91;
}

QPushButton:disabled {
    color: #697586;
    background-color: #DDE3EA;
    border-color: #CDD5DF;
}

QTableWidget {
    gridline-color: #D6DEE8;
    alternate-background-color: #F8FAFC;
}

QTableView {
    gridline-color: #D6DEE8;
    alternate-background-color: #F8FAFC;
    selection-background-color: #1F6FEB;
    selection-color: #FFFFFF;
}

QTableWidget::item {
    color: #17202A;
    background-color: #FFFFFF;
    padding: 4px;
}

QTableWidget::item:selected {
    color: #FFFFFF;
    background-color: #1F6FEB;
}

QHeaderView::section {
    color: #17202A;
    background-color: #E7ECF2;
    border: 0;
    border-right: 1px solid #CDD5DF;
    border-bottom: 1px solid #CDD5DF;
    padding: 7px 8px;
    font-weight: 600;
}

QStatusBar {
    color: #334155;
    background-color: #E7ECF2;
    border-top: 1px solid #CDD5DF;
}

QToolTip {
    color: #FFFFFF;
    background-color: #17202A;
    border: 1px solid #334155;
    padding: 4px 6px;
}

QLabel#pageTitle {
    color: #17202A;
    font-size: 20pt;
    font-weight: 700;
    padding: 4px 0 12px 0;
}

QLabel#errorLabel {
    color: #B42318;
    font-weight: 600;
}
