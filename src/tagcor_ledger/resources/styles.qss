QWidget {
    font-family: "Segoe UI Variable", "Segoe UI", "Microsoft JhengHei UI", "Microsoft JhengHei", "Noto Sans TC", sans-serif;
    font-size: 11pt;
    color: #E5E7EB;
    background-color: #0F172A;
}

QMainWindow,
QDialog,
QMessageBox {
    background-color: #0F172A;
    color: #E5E7EB;
}

QWidget#appShell {
    background-color: #0F172A;
}

QStackedWidget#contentStack,
QWidget#pageSurface {
    background-color: #0F172A;
}

QLabel,
QFormLayout QLabel,
QMessageBox QLabel {
    color: #E5E7EB;
    background-color: transparent;
}

QLabel#pageTitle {
    color: #F8FAFC;
    font-size: 20pt;
    font-weight: 700;
    padding: 2px 0 12px 0;
}

QLabel#hintLabel {
    color: #94A3B8;
    background-color: transparent;
}

QLabel#errorLabel {
    color: #FCA5A5;
    font-weight: 600;
}

QLineEdit,
QComboBox,
QDateEdit,
QDateTimeEdit,
QSpinBox,
QTableWidget,
QTableView,
QListWidget {
    color: #E5E7EB;
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QLineEdit,
QComboBox,
QDateEdit,
QDateTimeEdit,
QSpinBox {
    min-height: 30px;
}

QLineEdit {
    placeholder-text-color: #64748B;
}

QLineEdit:hover,
QComboBox:hover,
QDateEdit:hover,
QDateTimeEdit:hover,
QSpinBox:hover,
QTableView:hover,
QListWidget:hover {
    border-color: #475569;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QSpinBox:focus,
QTableView:focus,
QListWidget:focus {
    color: #F8FAFC;
    background-color: #0F172A;
    border: 2px solid #60A5FA;
}

QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QDateTimeEdit:disabled,
QSpinBox:disabled {
    color: #64748B;
    background-color: #1E293B;
    border-color: #334155;
}

QComboBox {
    padding-right: 30px;
}

QComboBox::drop-down,
QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    width: 28px;
    border-left: 1px solid #334155;
    background-color: #1E293B;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    color: #E5E7EB;
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: 0;
}

QAbstractItemView {
    color: #E5E7EB;
    background-color: #111827;
    alternate-background-color: #162033;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: 0;
}

QListWidget {
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 8px;
}

QListWidget::item {
    color: #E5E7EB;
    padding: 9px 10px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #1E293B;
}

QListWidget::item:selected {
    color: #FFFFFF;
    background-color: #2563EB;
}

QListWidget#sidebarNavigation {
    color: #CBD5E1;
    background-color: #0B1220;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 10px 8px;
}

QListWidget#sidebarNavigation::item {
    color: #CBD5E1;
    min-height: 34px;
    padding: 10px 12px;
    border-radius: 10px;
}

QListWidget#sidebarNavigation::item:hover {
    color: #F8FAFC;
    background-color: #1E293B;
}

QListWidget#sidebarNavigation::item:selected {
    color: #FFFFFF;
    background-color: #2563EB;
}

QListWidget#backupList {
    font-family: "Segoe UI Variable", "Segoe UI", "Microsoft JhengHei UI", "Noto Sans TC", sans-serif;
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 10px;
}

QPushButton {
    color: #CBD5E1;
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 30px;
}

QPushButton:hover {
    color: #F8FAFC;
    background-color: #27364D;
    border-color: #475569;
}

QPushButton:pressed {
    background-color: #162033;
}

QPushButton:focus {
    border: 2px solid #60A5FA;
}

QPushButton:disabled {
    color: #64748B;
    background-color: #1E293B;
    border-color: #334155;
}

QPushButton#primaryButton {
    color: #FFFFFF;
    background-color: #2563EB;
    border-color: #3B82F6;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #1D4ED8;
}

QPushButton#primaryButton:pressed {
    background-color: #1E40AF;
}

QPushButton#dangerButton {
    color: #FEE2E2;
    background-color: #7F1D1D;
    border-color: #B91C1C;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    color: #FFFFFF;
    background-color: #991B1B;
}

QPushButton#dangerButton:pressed {
    background-color: #450A0A;
}

QCheckBox {
    color: #E5E7EB;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #475569;
    border-radius: 5px;
    background-color: #111827;
}

QCheckBox::indicator:hover {
    border-color: #60A5FA;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #60A5FA;
}

QTabWidget::pane {
    border: 1px solid #334155;
    border-radius: 12px;
    top: -1px;
    background-color: #0F172A;
}

QTabBar::tab {
    color: #94A3B8;
    background-color: #111827;
    border: 1px solid #334155;
    border-bottom-color: #334155;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    padding: 8px 14px;
    margin-right: 6px;
    min-height: 24px;
}

QTabBar::tab:hover {
    color: #F8FAFC;
    background-color: #1E293B;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    background-color: #2563EB;
    border-color: #3B82F6;
    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #64748B;
    background-color: #111827;
}

QTableWidget,
QTableView {
    gridline-color: #263347;
    alternate-background-color: #162033;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    border-radius: 10px;
}

QTableWidget::item,
QTableView::item {
    color: #E5E7EB;
    padding: 6px;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #1E293B;
}

QTableWidget::item:selected,
QTableView::item:selected {
    color: #FFFFFF;
    background-color: #2563EB;
}

QHeaderView::section {
    color: #CBD5E1;
    background-color: #1E293B;
    border: 0;
    border-right: 1px solid #334155;
    border-bottom: 1px solid #334155;
    padding: 8px 10px;
    font-weight: 600;
}

QStatusBar {
    color: #94A3B8;
    background-color: #0B1220;
    border-top: 1px solid #1E293B;
}

QToolTip {
    color: #F8FAFC;
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 5px 7px;
}

QMenu {
    color: #E5E7EB;
    background-color: #111827;
    border: 1px solid #334155;
}

QMenu::item {
    padding: 7px 18px;
}

QMenu::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background-color: #0F172A;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #334155;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #475569;
}

QScrollBar:horizontal {
    background-color: #0F172A;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #334155;
    border-radius: 6px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #475569;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: transparent;
}

/* ---------------------------------------------------------------------------
 * 日曆彈出視窗
 *
 * 沒有這一節時，日曆會被上面幾條全域規則波及而壞掉：`QSpinBox` 的 padding 撐爆
 * 年份輸入框、`QAbstractItemView` 的 padding 讓日期格容不下兩位數字，於是每一格都
 * 顯示成「...」。2026-08-18 實機看到的就是那個畫面。
 *
 * 所以這裡的每一條都用 `QCalendarWidget` 開頭，把日曆從全域規則裡隔出來。
 * --------------------------------------------------------------------------- */

QCalendarWidget {
    background-color: #111827;
}

/* 上方的月份／年份列 */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #1E293B;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 34px;
}

QCalendarWidget QToolButton {
    color: #E5E7EB;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    margin: 2px;
    font-size: 10.5pt;
}

QCalendarWidget QToolButton:hover {
    background-color: #334155;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

/* 年份輸入框：全域 QSpinBox 的 padding 會把它撐到超出導覽列 */
QCalendarWidget QSpinBox {
    color: #E5E7EB;
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 1px 4px;
    margin: 2px;
    min-height: 0;
    min-width: 64px;
}

/* 月份選單 */
QCalendarWidget QMenu {
    color: #E5E7EB;
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

/* 日期格。padding 要是 0 —— 全域 QAbstractItemView 的 padding 正是把
 * 兩位數日期擠成「...」的原因。 */
QCalendarWidget QAbstractItemView {
    color: #E5E7EB;
    background-color: #111827;
    alternate-background-color: #111827;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    padding: 0;
    outline: 0;
    font-size: 10pt;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #E5E7EB;
}

/* 上／下個月的日期灰掉，避免誤點 */
QCalendarWidget QAbstractItemView:disabled {
    color: #475569;
}

/* 星期標題列 */
QCalendarWidget QWidget {
    alternate-background-color: #162033;
}
