/* ===========================================================================
 * TagCor Ledger — 固定深色主題（中性純灰）
 *
 * **色碼的正本是 `ui/colors.py`。** 這裡出現的每一個色碼都必須在那份清單裡，
 * `tests/unit/test_resources.py` 會掃過來比對 —— 想加新顏色就先去那邊宣告。
 *
 *   #0D0D0F  底層      #16161A  卡片/表格/輸入框   #1F1F25  懸停/次要按鈕
 *   #2E2E38  選取列    #33333C  邊框               #3A3A44  懸停邊框
 *   #E8E8EA  主要文字  #9A9AA5  次要文字           #7A7A85  停用/placeholder
 *   #B4B4BE  焦點框    #8C2F2A  危險               #F0736A 支出   #5EC07C 收入
 *
 * 介面本身幾乎沒有顏色：主要按鈕靠明度（近白底深字）而不是彩色，選取列是灰的。
 * 所以畫面上任何一抹紅或綠都一定是資訊。
 * =========================================================================== */

QWidget {
    font-family: "Microsoft JhengHei UI", "Microsoft JhengHei", "Noto Sans TC", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 12pt;
    color: #E8E8EA;
    background-color: #0D0D0F;
}

QMainWindow,
QDialog,
QMessageBox {
    background-color: #0D0D0F;
    color: #E8E8EA;
}

QWidget#appShell {
    background-color: #0D0D0F;
}

QStackedWidget#contentStack,
QWidget#pageSurface {
    background-color: #0D0D0F;
}

QLabel,
QFormLayout QLabel,
QMessageBox QLabel {
    color: #E8E8EA;
    background-color: transparent;
}

QLabel#pageTitle {
    color: #E8E8EA;
    font-size: 17pt;
    font-weight: 600;
    padding: 0 0 10px 0;
}

/* 區塊小標：分頁裡的第二層標題，比 pageTitle 低一階 */
QLabel#sectionTitle {
    color: #9A9AA5;
    font-size: 10pt;
    font-weight: 600;
    padding: 12px 0 4px 0;
}

QLabel#hintLabel {
    color: #9A9AA5;
    background-color: transparent;
}

/* 總資產：資產總覽唯一的主角。字級要明顯大過 pageTitle，
 * 不然它只是「另一個標題」，而這一頁存在的理由就是讓這個數字一眼可見。 */
QLabel#totalAmount {
    color: #E8E8EA;
    font-size: 30pt;
    font-weight: 600;
    padding: 0 0 6px 0;
}

/* 狀態訊息：同一個標籤既報成功也報失敗，靠 state 屬性換色。
 * 舊版把「交易已儲存。」寫進紅色的 errorLabel，成功長得像失敗。 */
QLabel#statusLabel {
    color: #9A9AA5;
    background-color: transparent;
    font-weight: 600;
}

QLabel#statusLabel[state="ok"] {
    color: #5EC07C;
}

QLabel#statusLabel[state="error"] {
    color: #F0736A;
}

QLabel#errorLabel {
    color: #F0736A;
    font-weight: 600;
}

QLineEdit,
QComboBox,
QDateEdit,
QDateTimeEdit,
QSpinBox,
QTableWidget,
QTableView,
QListWidget {
    color: #E8E8EA;
    background-color: #16161A;
    border: 1px solid #33333C;
    border-radius: 6px;
    padding: 7px 10px;
    selection-background-color: #2E2E38;
    selection-color: #E8E8EA;
}

QLineEdit,
QComboBox,
QDateEdit,
QDateTimeEdit,
QSpinBox {
    min-height: 30px;
}

QLineEdit {
    placeholder-text-color: #7A7A85;
}

/* 金額輸入框：記帳那一頁真正的主角，但**只靠字重**。
   以前它同時放大三個維度（15pt、600、40px 高），那是金額還排在第三列、
   緊貼著「流向」的年代訂的 —— 在最上面當標題看剛好。v0.24.1 把它移到日期與備註
   之間之後，上下都是 30px 的一般欄位，同樣的對比就從「標題」變成「中間凸一塊」。
   字級與高度跟其他欄位統一，粗體留著就足夠說明「這一格每次都要動手」。 */
QLineEdit#amountInput {
    font-weight: 600;
}

QLineEdit:hover,
QComboBox:hover,
QDateEdit:hover,
QDateTimeEdit:hover,
QSpinBox:hover,
QTableView:hover,
QListWidget:hover {
    border-color: #3A3A44;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QSpinBox:focus,
QTableView:focus,
QListWidget:focus {
    color: #E8E8EA;
    background-color: #16161A;
    border: 2px solid #B4B4BE;
}

QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QDateTimeEdit:disabled,
QSpinBox:disabled {
    color: #7A7A85;
    background-color: #1F1F25;
    border-color: #33333C;
}

QComboBox {
    padding-right: 8px;
}

/* 這裡**刻意沒有 `::drop-down` 規則**。
 *
 * QSS 一旦碰了那個 subcontrol，Fusion 就不再畫箭頭，而 QSS 只能用圖片補 ——
 * 專案不打包圖檔，結果就是一塊空白方格，看起來像壞掉的欄位。
 * 2026-08-19 截圖比對時確認：整條拿掉，箭頭就回來了。 */

QComboBox QAbstractItemView {
    color: #E8E8EA;
    background-color: #16161A;
    border: 1px solid #33333C;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #2E2E38;
    selection-color: #E8E8EA;
    outline: 0;
}

QAbstractItemView {
    color: #E8E8EA;
    background-color: #16161A;
    alternate-background-color: #1F1F25;
    selection-background-color: #2E2E38;
    selection-color: #E8E8EA;
    outline: 0;
}

QListWidget {
    background-color: #16161A;
    border: 1px solid #33333C;
    border-radius: 8px;
    padding: 6px;
}

QListWidget::item {
    color: #E8E8EA;
    padding: 9px 10px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #1F1F25;
}

QListWidget::item:selected {
    color: #E8E8EA;
    background-color: #2E2E38;
}

/* 側邊欄外框。**分隔線畫在這一層，不能畫在清單上** —— 側邊欄是兩個清單夾一段
 * 會伸縮的留白（日常在上、設定沉底），線若畫在清單上就會跟著斷成兩截。
 * 內距也移到這一層，清單本身的高度才等於它的內容高度（見 `widgets/sidebar.py`）。 */
QFrame#sidebarRail {
    background-color: #0D0D0F;
    border: 0;
    border-right: 1px solid #33333C;
    border-radius: 0;
}

QListWidget#sidebarNavigation {
    color: #9A9AA5;
    background-color: #0D0D0F;
    border: 0;
    border-radius: 0;
    padding: 0;
}

QListWidget#sidebarNavigation::item {
    color: #9A9AA5;
    min-height: 32px;
    padding: 9px 12px;
    border-radius: 6px;
}

QListWidget#sidebarNavigation::item:hover {
    color: #E8E8EA;
    background-color: #16161A;
}

QListWidget#sidebarNavigation::item:selected {
    color: #E8E8EA;
    background-color: #1F1F25;
    font-weight: 600;
}

QListWidget#backupList {
    font-family: "Microsoft JhengHei UI", "Microsoft JhengHei", "Noto Sans TC", sans-serif;
    background-color: #16161A;
    border: 1px solid #33333C;
    border-radius: 8px;
    padding: 8px;
}

QPushButton {
    color: #E8E8EA;
    background-color: #1F1F25;
    border: 1px solid #33333C;
    border-radius: 6px;
    padding: 8px 14px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #2E2E38;
    border-color: #3A3A44;
}

QPushButton:pressed {
    background-color: #16161A;
}

QPushButton:focus {
    border: 2px solid #B4B4BE;
}

QPushButton:disabled {
    color: #7A7A85;
    background-color: #16161A;
    border-color: #33333C;
}

/* 主要動作：近白底、近黑字。**不用彩色** —— 對比 14.75，比任何彩色按鈕都跳。 */
QPushButton#primaryButton {
    color: #0D0D0F;
    background-color: #E8E8EA;
    border-color: #E8E8EA;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    color: #0D0D0F;
    background-color: #FFFFFF;
    border-color: #FFFFFF;
}

QPushButton#primaryButton:pressed {
    background-color: #C9C9D0;
    border-color: #C9C9D0;
}

QPushButton#primaryButton:disabled {
    color: #7A7A85;
    background-color: #1F1F25;
    border-color: #33333C;
}

QPushButton#dangerButton {
    color: #FFFFFF;
    background-color: #8C2F2A;
    border-color: #8C2F2A;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #A33A34;
    border-color: #A33A34;
}

QPushButton#dangerButton:pressed {
    background-color: #6E241F;
    border-color: #6E241F;
}

QPushButton#dangerButton:disabled {
    color: #7A7A85;
    background-color: #1F1F25;
    border-color: #33333C;
}

/* 流向切換：支出／收入／轉帳三顆連在一起，一下就選好，不必展開下拉 */
QPushButton#segmentButton {
    color: #9A9AA5;
    background-color: #16161A;
    border: 1px solid #33333C;
    border-radius: 6px;
    padding: 8px 20px;
    min-height: 32px;
    font-weight: 600;
}

QPushButton#segmentButton:hover {
    color: #E8E8EA;
    background-color: #1F1F25;
}

QPushButton#segmentButton:checked {
    color: #0D0D0F;
    background-color: #E8E8EA;
    border-color: #E8E8EA;
}

QCheckBox {
    color: #E8E8EA;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3A3A44;
    border-radius: 4px;
    background-color: #16161A;
}

QCheckBox::indicator:hover {
    border-color: #B4B4BE;
}

/* 已勾選＝白底 ＋ 一個**勾號**。
   實心白與空心黑的對比有 14:1，兩個狀態絕不會看成一樣 —— 但「哪一個代表開」
   仍然要靠慣例。五個勾選框裡有兩個守著不可逆的操作（還原前／重製前先建立備份），
   那兩個不該要求使用者知道慣例，所以第二個線索用**形狀**，與「選取列靠底色 ＋
   上下橫線」「金額同時有正負號與右對齊」是同一條原則。

   底下那個佔位字串由 `theme.py` 在載入時代換成 `check.png` 的實際路徑
   （`CHECK_ICON_PLACEHOLDER`）。**不要把它改成寫死的路徑** —— 資源位置隨安裝方式
   而變。取不到檔案時 `theme.py` 會把整行拿掉，退回沒有勾號的實心白方框；留著一個
   壞掉的 url() 更糟，Qt 會連 background-color 都不畫。

   這段說明**刻意不寫出那個佔位字串本身** —— 代換是整份字串替換，寫在這裡的話
   註解也會被換成一條路徑。 */
QCheckBox::indicator:checked {
    background-color: #E8E8EA;
    border-color: #E8E8EA;
    image: url(%CHECK_ICON%);
}

QTabWidget::pane {
    border: 0;
    border-top: 1px solid #33333C;
    top: -1px;
    background-color: #0D0D0F;
}

/* 分頁改成底線式：沒有色塊，選中的那一個靠一條白線與粗體表示 */
QTabBar::tab {
    color: #9A9AA5;
    background-color: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin-right: 4px;
    min-height: 22px;
}

QTabBar::tab:hover {
    color: #E8E8EA;
}

QTabBar::tab:selected {
    color: #E8E8EA;
    border-bottom: 2px solid #E8E8EA;
    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #7A7A85;
}

/* 表格**不設文字顏色**。
 *
 * QSS 的 `color` 與 `selection-color` 會蓋過 model 的 `ForegroundRole`，
 * 於是支出的紅、收入的綠全部被壓成同一個白 —— 2026-08-19 截圖比對時發現。
 * 顏色交給 model 決定（見 `widgets/table.py` 的 `amount_color`），
 * 這裡只管背景、間距與格線。 */
QTableWidget,
QTableView {
    gridline-color: #1F1F25;
    alternate-background-color: #16161A;
    selection-background-color: #2E2E38;
    border-radius: 8px;
    padding: 0;
}

QTableWidget::item,
QTableView::item {
    padding: 7px 8px;
    border: 0;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #1F1F25;
}

/* 選取列：底色 ＋ 上下兩條橫線。
 *
 * **底色一個人扛不起來。** 選取底 #2E2E38 對一般列底 #16161A 的對比只有 1.34，
 * 而它已經是上限了 —— 再亮一階，支出紅對選取列的對比就掉到 4.5 以下。
 * 明度這個維度在深色主題裡本來就很窄，硬撐只會兩件事都做不好。
 *
 * 橫線是**形狀**，不吃明度預算：每一格都畫上下框線，接起來就是一條貫穿整列的線。
 *
 * **padding 要從 7px 收成 6px。** 列高由 `verticalHeader().defaultSectionSize()`
 * 固定在 34px，而 Qt 的 ::item 是 content-box —— 直接加 2px 框線會把文字的可用高度
 * 壓掉 2px，中文的上下就會被切到。7+1 = 6+1+1，選取前後的內容高度一模一樣。 */
QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #2E2E38;
    padding: 6px 8px;
    border-top: 1px solid #9A9AA5;
    border-bottom: 1px solid #9A9AA5;
}

QHeaderView::section {
    color: #9A9AA5;
    background-color: #0D0D0F;
    border: 0;
    border-bottom: 1px solid #33333C;
    padding: 8px;
    font-weight: 600;
}

QTableView QTableCornerButton::section {
    background-color: #0D0D0F;
    border: 0;
    border-bottom: 1px solid #33333C;
}

QStatusBar {
    color: #7A7A85;
    background-color: #0D0D0F;
    border-top: 1px solid #33333C;
}

QStatusBar::item {
    border: 0;
}

QToolTip {
    color: #E8E8EA;
    background-color: #1F1F25;
    border: 1px solid #3A3A44;
    border-radius: 4px;
    padding: 5px 7px;
}

QMenu {
    color: #E8E8EA;
    background-color: #16161A;
    border: 1px solid #33333C;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2E2E38;
    color: #E8E8EA;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #33333C;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3A3A44;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #33333C;
    border-radius: 6px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3A3A44;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: transparent;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

QGroupBox {
    border: 1px solid #33333C;
    border-radius: 8px;
    margin-top: 12px;
    padding: 14px 12px 12px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #9A9AA5;
    font-weight: 600;
}

QFrame#separator {
    background-color: #33333C;
    border: 0;
    max-height: 1px;
}

/* ---------------------------------------------------------------------------
 * 日曆彈出視窗
 *
 * 沒有這一節時，日曆會被上面幾條全域規則波及而壞掉：`QSpinBox` 的 padding 撐爆
 * 年份輸入框、`QAbstractItemView` 的 padding 讓日期格容不下兩位數字，於是每一格都
 * 顯示成「...」。2026-08-18 實機看到的就是那個畫面。
 *
 * 所以這裡的每一條都用 `QCalendarWidget` 開頭，把日曆從全域規則裡隔出來。
 * --------------------------------------------------------------------------- */

QCalendarWidget {
    background-color: #16161A;
}

/* 上方的月份／年份列 */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #1F1F25;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-height: 34px;
}

QCalendarWidget QToolButton {
    color: #E8E8EA;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    margin: 2px;
    font-size: 10.5pt;
}

QCalendarWidget QToolButton:hover {
    background-color: #33333C;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

/* 年份輸入框：全域 QSpinBox 的 padding 會把它撐到超出導覽列 */
QCalendarWidget QSpinBox {
    color: #E8E8EA;
    background-color: #0D0D0F;
    border: 1px solid #33333C;
    border-radius: 4px;
    padding: 1px 4px;
    margin: 2px;
    min-height: 0;
    min-width: 64px;
}

/* 月份選單 */
QCalendarWidget QMenu {
    color: #E8E8EA;
    background-color: #16161A;
    border: 1px solid #33333C;
    border-radius: 6px;
    padding: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #2E2E38;
    color: #E8E8EA;
}

/* 日期格。
 *
 * **padding 要清在 `::item` 上，不是清在 view 上。** 這一條 2026-08-18 修錯過一次：
 * 當時只寫了底下那條 view 的 `padding: 0`，而真正把日期擠掉的是上面
 * 「表格」那一節的 `QTableView::item { padding: 7px 8px }` —— 日曆的日期格
 * 就是一個 `QTableView`。view 的 padding 管的是 viewport，管不到每一格。
 *
 * 症狀是每一格都顯示成「...」。2026-08-21 量到的數字：格子 33x21，但
 * `SE_ItemViewItemText` 只剩 17x7，而 10pt 中文字要 16 px 高 —— 高度不夠就省略。
 * 清掉之後同一格是 33x21，兩位數日期正常顯示。 */
QCalendarWidget QAbstractItemView::item {
    padding: 0;
}

QCalendarWidget QAbstractItemView {
    color: #E8E8EA;
    background-color: #16161A;
    alternate-background-color: #16161A;
    selection-background-color: #E8E8EA;
    selection-color: #0D0D0F;
    padding: 0;
    outline: 0;
    font-size: 10pt;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #E8E8EA;
}

/* 上／下個月的日期灰掉，避免誤點 */
QCalendarWidget QAbstractItemView:disabled {
    color: #3A3A44;
}

/* 星期標題列 */
QCalendarWidget QWidget {
    alternate-background-color: #16161A;
}
