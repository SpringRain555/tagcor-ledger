#!/bin/sh
#
# D:\Projects 共用 pre-commit 守門
#
# 用途：.gitignore 負責讓 git status 乾淨，這個 hook 負責讓大檔進不了歷史。
#       兩者分工不同 —— .gitignore 可能被改壞、可能漏掉新出現的目錄，
#       但一旦大檔進了 git 歷史，就得重寫歷史才拿得掉。
#
# 來源：沿用 D:\Obsidian\Certs\.githooks\pre-commit 與
#       ai-artist-webui-aki\scripts\Test-RepositoryPolicy.ps1 的既有做法。
#
# 啟用：git config core.hooksPath .githooks
#
# 例外：確定要提交大檔時用 git commit --no-verify

LIMIT_MB=5
LIMIT=$((LIMIT_MB * 1024 * 1024))
FAILED=0

while IFS= read -r file; do
	[ -n "$file" ] || continue
	size=$(git cat-file -s ":$file" 2>/dev/null) || continue
	if [ "$size" -gt "$LIMIT" ]; then
		if [ "$FAILED" -eq 0 ]; then
			echo ""
			echo "✗ 提交被擋下：以下檔案超過 ${LIMIT_MB} MB"
			echo ""
			FAILED=1
		fi
		printf '    %6s MB  %s\n' "$((size / 1048576))" "$file"
	fi
done <<EOF
$(git diff --cached --name-only --diff-filter=AM)
EOF

if [ "$FAILED" -ne 0 ]; then
	cat <<'MSG'

  這裡的 git 只追蹤「自己寫的東西」。
  素材與產物（影片／照片／模型權重／資料集／封存 zip）留在磁碟上，由備份保護。

  處理方式：
    1. 若是素材或產物 → git restore --staged <檔案>，並把它加進 .gitignore
    2. 確定要提交      → git commit --no-verify

  規範見 D:\Projects\_meta\CONVENTIONS.md 第 6 節。

MSG
	exit 1
fi

# ============================================================================
# 以下為 tagcor-ledger 專屬。**上面那一段是 D:\Projects 的共用慣例，不要改它。**
#
# hook 與 CI 是兩層，不是二選一（2026-09-01 推上 GitHub 之前這裡寫的是
# 「沒有 remote，GitHub Actions 沒地方跑」—— 那個前提已經不成立）：
#   hook 快、在 commit 當下擋，但 --no-verify 繞得過，也只跑得動本機有的東西
#   CI  慢、擋的是推上去之後，繞不過，而且跑在乾淨環境裡
#
# 為什麼只有 ruff 與 mypy：實測 ruff 0.1 秒、mypy 1.6 秒，加起來感覺不到。
# **pytest 不進來** —— 整包 66 秒，那會讓人習慣性打 --no-verify，
# 而一個被習慣性繞過的閘門比沒有閘門更糟（它讓人以為有守）。
# 測試由 .github/workflows/verify.yml 在 CI 跑；發版前仍然自己跑 .\Verify.ps1 -Ui。
# ============================================================================

# 直譯器查找與 pre-push 共用同一份，見 .githooks/resolve-python.sh。
. "$(dirname "$0")/resolve-python.sh"
PYTHON="$(resolve_tagcor_python)"

# 找不到直譯器就放行 —— 在別台機器 clone 下來時不該連 commit 都不能做。
if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
	echo "  提示：找不到專案的 conda 直譯器，略過 lint／型別閘門。"
	exit 0
fi

if ! "$PYTHON" -m ruff check --no-cache . ; then
	echo ""
	echo "✗ ruff 沒過。修好再 commit，或 git commit --no-verify。"
	exit 1
fi

# 這裡**不加 --no-incremental**（Verify.ps1 才加）。hook 要快，
# 而 mypy 的快取判斷對「檔案剛改完就檢查」這個情境是準的。
if ! "$PYTHON" -m mypy src ; then
	echo ""
	echo "✗ mypy --strict 沒過。修好再 commit，或 git commit --no-verify。"
	exit 1
fi

exit 0
