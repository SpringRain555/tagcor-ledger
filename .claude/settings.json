{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(<資料根目錄>/**)",
      "Glob(<資料根目錄>/**)",
      "Grep(<資料根目錄>/**)"
    ],
    "ask": [
      "Read(<私人資料樹>/**)",
      "Glob(<私人資料樹>/**)",
      "Grep(<私人資料樹>/**)"
    ],
    "deny": [
      "Edit(<私人資料樹>/**)",
      "Write(<私人資料樹>/**)"
    ]
  }
}
